generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  super_admin
  admin
  trainer
  client
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  legs
  glutes
  abs
  cardio
  full_body
  quads
  hamstrings
  calves
  forearms
  traps
  core
  abductors
  adductors
  hybrid
}

// DayOfWeek se mantiene para compatibilidad pero las rutinas ahora usan dayNumber
enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ─── Models ──────────────────────────────────────────────

model Gym {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branches    Branch[]
  users       User[]

  @@map("gyms")
}

model Branch {
  id          String   @id @default(uuid())
  gymId       String   @map("gym_id")
  name        String   // "Sede Poblado", "Sede Laureles", "Sede Central", etc.
  slug        String
  address     String?
  city        String?  @default("Medellín")
  phone       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  users       User[]
  invitationCodes InvitationCode[]

  @@unique([gymId, slug])
  @@map("branches")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  password            String
  role                UserRole @default(client)
  trainerId           String?  @map("trainer_id")
  gymId               String?  @map("gym_id")
  branchId            String?  @map("branch_id")
  avatarUrl           String?  @map("avatar_url")
  phone               String?
  dietaryGoal         String?  @map("dietary_goal") // Usado para el objetivo fitness
  weight              Float?
  height              Float?
  targetCalories      Int?     @map("target_calories")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")

  // Perfil Avanzado (Onboarding Extendido)
  experienceLevel    String? @map("experience_level")
  equipmentAccess    String? @map("equipment_access")
  medicalConditions  String? @map("medical_conditions")
  dietaryPreferences String? @map("dietary_preferences")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resetToken        String?   @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")

  // Relaciones
  trainer User?  @relation("TrainerClients", fields: [trainerId], references: [id])
  clients User[] @relation("TrainerClients")
  gym     Gym?   @relation(fields: [gymId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  meals             Meal[]
  dietChatMessages  DietChatMessage[]
  routinesAsClient  Routine[]         @relation("ClientRoutines")
  routinesAsTrainer Routine[]         @relation("TrainerRoutines")
  workoutLogs       WorkoutLog[]

  codesGenerated InvitationCode[] @relation("TrainerCodes")
  usedCode       InvitationCode?  @relation("UsedByUser")
  dailyTasks     DailyTask[]
  taskLogs       TaskLog[]
  waterLogs      WaterLog[]
  pushSubscriptions NotificationSubscription[]
  notificationPrefs  NotificationPreference?
  colleaguesAsA      TrainerColleague[]         @relation("ColleagueA")
  colleaguesAsB      TrainerColleague[]         @relation("ColleagueB")
  dailyStressLogs    DailyStressLog[]
  weeklyCheckins     WeeklyCheckin[]
  paymentsAsClient   ClientPayment[]            @relation("ClientPayments")
  paymentsAsTrainer  ClientPayment[]            @relation("TrainerPayments")
  assessmentsAsClient  PhysicalAssessment[]     @relation("ClientAssessments")
  assessmentsAsTrainer PhysicalAssessment[]     @relation("TrainerAssessments")

  @@index([trainerId, isActive])
  @@index([branchId, isActive])
  @@index([gymId, isActive])
  @@map("users")
}

model InvitationCode {
  id           String   @id @default(uuid())
  code         String   @unique
  trainerId    String   @map("trainer_id")
  branchId     String?  @map("branch_id")
  isUsed       Boolean  @default(false) @map("is_used")
  usedByUserId String?  @unique @map("used_by_user_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relaciones
  trainer User    @relation("TrainerCodes", fields: [trainerId], references: [id])
  usedBy  User?   @relation("UsedByUser", fields: [usedByUserId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@map("invitation_codes")
}

model Meal {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  description      String
  imageUrl         String?  @map("image_url")
  imageUrls        String[] @default([]) @map("image_urls")
  mealType         MealType @map("meal_type")
  // Información nutricional (aplanada)
  calories         Float    @default(0)
  protein          Float    @default(0)
  carbs            Float    @default(0)
  fat              Float    @default(0)
  fiber            Float    @default(0)
  sugar            Float    @default(0)
  foods            String[] @default([])
  recommendation   String?
  goalRating       String?  @map("goal_rating")
  isRecommendation Boolean  @default(false) @map("is_recommendation")
  recommendedBy    String?  @map("recommended_by")
  date             DateTime @default(now())
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relaciones
  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([date])
  @@map("meals")
}

model DietChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String // "user" o "ai"
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diet_chat_messages")
}

model Routine {
  id          String   @id @default(uuid())
  name        String // "RUTINA SEMANA 1 - 4"
  description String   @default("")
  trainerId   String   @map("trainer_id")
  clientId    String   @map("client_id")
  weekCount   Int      @default(4) @map("week_count") // Número de semanas (default 4)
  isFavorable Boolean? @map("is_favorable")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  trainer     User         @relation("TrainerRoutines", fields: [trainerId], references: [id])
  client      User         @relation("ClientRoutines", fields: [clientId], references: [id])
  routineDays RoutineDay[]

  @@index([trainerId, isActive])
  @@index([clientId, isActive])
  @@map("routines")
}

// Cada día dentro de una rutina (Día 1 Cuádriceps, Día 2 Espalda, etc.)
model RoutineDay {
  id          String   @id @default(uuid())
  routineId   String   @map("routine_id")
  dayNumber   Int      @map("day_number") // 1, 2, 3, 4, 5...
  focusArea   String   @map("focus_area") // "Cuádriceps", "Espalda y Hombros", etc.
  isRestDay   Boolean  @default(false) @map("is_rest_day") // Día 4: Descanso total
  restDayNote String?  @map("rest_day_note") // "DÍA CLAVE. El crecimiento ocurre aquí"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  routine   Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@unique([routineId, dayNumber])
  @@map("routine_days")
}

model Exercise {
  id           String      @id @default(uuid())
  routineDayId String      @map("routine_day_id")
  name         String
  muscleGroup  MuscleGroup @map("muscle_group")
  sets         Int
  reps         String // "8-12", "10-15", "Fallo técnico"
  restSeconds  Int         @default(60) @map("rest_seconds")
  observations String? // "180'' descanso", "Por pierna", "En polea"
  videoUrl     String?     @map("video_url")
  order        Int         @default(0)
  targetWeight Float?      @map("target_weight")
  intensity    String?     @default("medium")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relaciones
  routineDay  RoutineDay   @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  workoutLogs WorkoutLog[]

  @@map("exercises")
}

// Registro semanal: el cliente trackea peso, reps y observaciones por ejercicio por semana
model WorkoutLog {
  id           String    @id @default(uuid())
  exerciseId   String    @map("exercise_id")
  userId       String    @map("user_id") // El cliente
  weekNumber   Int       @map("week_number") // 1, 2, 3, 4
  weight       Float? // Peso usado (kg) — resumen / peso principal
  repsDone     String?   @map("reps_done") // Reps logradas — resumen
  observations String? // Notas del cliente
  setsData     Json?     @map("sets_data") // [{set:1, weight:40, reps:12, completed:true}, ...]
  duration     Int? // Duración total en segundos
  completedAt  DateTime? @map("completed_at") // Cuándo se marcó como completado
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relaciones
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([exerciseId, userId, weekNumber])
  @@map("workout_logs")
}

model ExerciseDictionary {
  id                 String      @id @default(uuid())
  name               String      @unique
  muscleGroup        MuscleGroup @map("muscle_group")
  videoUrl           String?     @map("video_url")
  equipment          String?     // "barbell", "dumbbell", "body weight", etc.
  category           String?     // "upper arms", "chest", "back", etc. (body_part del dataset)
  target             String?     // "biceps", "pectoralis major", "abs", etc.
  gifUrl             String?     @map("gif_url")
  imageUrl           String?     @map("image_url")
  instructionsEs     String?     @map("instructions_es") @db.Text
  instructionStepsEs String[]    @default([]) @map("instruction_steps_es")
  secondaryMuscles   String[]    @default([]) @map("secondary_muscles")
  attribution        String?
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("exercise_dictionary")
}

// ─── Daily Tasks (Checklist de tareas diarias) ──────────

model DailyTask {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   // "Desayunar", "Entrenar", "Almorzar", etc.
  icon      String   @default("✅") // Emoji
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs TaskLog[]

  @@index([userId, isActive])
  @@map("daily_tasks")
}

model TaskLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  date      String   // "2026-03-06" — fecha local del usuario
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([userId, date])
  @@map("task_logs")
}

// ─── Water Tracking ─────────────────────────────────────

model WaterLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String   // "2026-03-06"
  amount    Int      @default(0) // number of glasses
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("water_logs")
}

// ─── Browser Push Notifications ────────────────────────

model NotificationSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("notification_subscriptions")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  enabled         Boolean  @default(true)
  breakfastTime   String   @default("08:00") @map("breakfast_time")
  lunchTime       String   @default("13:00") @map("lunch_time")
  dinnerTime      String   @default("20:00") @map("dinner_time")
  workoutTime     String   @default("18:00") @map("workout_time")
  timezoneOffset  Int      @default(0) @map("timezone_offset")
  lastBreakfastAt String?  @map("last_breakfast_at")
  lastLunchAt     String?  @map("last_lunch_at")
  lastDinnerAt    String?  @map("last_dinner_at")
  lastWorkoutAt   String?  @map("last_workout_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Trainer Colleague Links (Cartera compartida entre entrenadores) ──
model TrainerColleague {
  id              String   @id @default(uuid())
  trainerAId      String   @map("trainer_a_id")
  trainerBId      String   @map("trainer_b_id")
  gymId           String?  @map("gym_id")
  mode            String   @default("bidirectional") @map("mode") // "bidirectional" | "unidirectional"
  sharedClientIds String[] @default([]) @map("shared_client_ids")
  createdAt       DateTime @default(now()) @map("created_at")

  trainerA   User     @relation("ColleagueA", fields: [trainerAId], references: [id], onDelete: Cascade)
  trainerB   User     @relation("ColleagueB", fields: [trainerBId], references: [id], onDelete: Cascade)

  @@unique([trainerAId, trainerBId])
  @@index([trainerAId])
  @@index([trainerBId])
  @@map("trainer_colleagues")
}

// ─── Daily Stress Tracking ──────────────────────────────
model DailyStressLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        String   // "YYYY-MM-DD"
  stressLevel Int      @default(5) @map("stress_level") // 1 to 10
  mood        String?  // "calm", "focused", "tired", "anxious", "energized"
  energyLevel Int?     @default(5) @map("energy_level") // 1 to 10
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_stress_logs")
}

// ─── Weekly Check-in (Chequeo Semanal de los Lunes) ─────
model WeeklyCheckin {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  weekDate       String   @map("week_date") // "YYYY-MM-DD" del lunes
  stressRating   Int      @default(5) @map("stress_rating") // 1 to 10
  energyRating   Int      @default(5) @map("energy_rating") // 1 to 10
  recoveryRating String?  @map("recovery_rating") // "excelente", "buena", "regular", "mala"
  dietPerception String?  @map("diet_perception") // "100%", "buena", "regular", "deficiente"
  notes          String?
  rawAnswers     Json?    @map("raw_answers")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekDate])
  @@index([userId, weekDate])
  @@map("weekly_checkins")
}

// ─── Client Payments / Membership Tracking ─────────────────
model ClientPayment {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  trainerId     String    @map("trainer_id")
  gymId         String?   @map("gym_id")
  periodMonth   String    @map("period_month") // "YYYY-MM", ej. "2026-09"
  amount        Float     @default(0)
  status        String    @default("PENDING") // "PAID" | "PENDING" | "OVERDUE"
  paymentMethod String?   @map("payment_method") // "Nequi", "Bancolombia", "Efectivo", "Tarjeta", "Daviplata", "Otro"
  paymentDate   DateTime? @map("payment_date")
  notes         String?
  receiptUrl    String?   @map("receipt_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client        User      @relation("ClientPayments", fields: [clientId], references: [id], onDelete: Cascade)
  trainer       User      @relation("TrainerPayments", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([clientId, periodMonth])
  @@index([clientId])
  @@index([trainerId])
  @@index([periodMonth])
  @@map("client_payments")
}

// ─── Physical Assessments (Valoraciones Corporales) ─────────
model PhysicalAssessment {
  id               String   @id @default(uuid())
  clientId         String   @map("client_id")
  trainerId        String   @map("trainer_id")
  date             DateTime @default(now())

  // Perímetros Corporales (cm)
  neck             Float?   // Cuello
  back             Float?   // Espalda
  rightArm         Float?   @map("right_arm") // Brazo D
  leftArm          Float?   @map("left_arm") // Brazo I
  waist            Float?   // Cintura
  hip              Float?   // Cadera
  rightThigh       Float?   @map("right_thigh") // Pierna D
  leftThigh        Float?   @map("left_thigh") // Pierna I
  rightKnee        Float?   @map("right_knee") // Rodilla D
  leftKnee         Float?   @map("left_knee") // Rodilla I
  rightCalf        Float?   @map("right_calf") // Pantorrilla D
  leftCalf         Float?   @map("left_calf") // Pantorrilla I

  // Composición Corporal
  weight           Float?   // Peso (kg)
  fatPercentage    Float?   @map("fat_percentage") // % Grasa
  musclePercentage Float?   @map("muscle_percentage") // % Muscular
  waterPercentage  Float?   @map("water_percentage") // % Líquido
  bonePercentage   Float?   @map("bone_percentage") // % Óseo

  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  client           User     @relation("ClientAssessments", fields: [clientId], references: [id], onDelete: Cascade)
  trainer          User     @relation("TrainerAssessments", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([trainerId])
  @@map("physical_assessments")
}

